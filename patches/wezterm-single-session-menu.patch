 }
 impl_lua_conversion_dynamic!(KeyAssignment);
 
+impl KeyAssignment {
+    /// Actions that can escape a terminal session intended to use one window,
+    /// one tab and one pane. Closing the existing pane/tab remains allowed.
+    pub fn is_disallowed_in_single_session(&self) -> bool {
+        match self {
+            Self::SpawnTab(_)
+            | Self::SpawnWindow
+            | Self::SpawnCommandInNewTab(_)
+            | Self::SpawnCommandInNewWindow(_)
+            | Self::SplitHorizontal(_)
+            | Self::SplitVertical(_)
+            | Self::SplitPane(_)
+            | Self::ShowLauncher
+            | Self::ShowLauncherArgs(_)
+            | Self::ActivateCommandPalette
+            | Self::AttachDomain(_)
+            | Self::DetachDomain(_)
+            | Self::SwitchToWorkspace { .. }
+            | Self::SwitchWorkspaceRelative(_) => true,
+            Self::PaneSelect(args) => matches!(
+                args.mode,
+                PaneSelectMode::MoveToNewTab | PaneSelectMode::MoveToNewWindow
+            ),
+            Self::Multiple(actions) => actions.iter().any(Self::is_disallowed_in_single_session),
+            _ => false,
+        }
+    }
+}
+
+#[cfg(test)]
+mod single_session_tests {
+    use super::{KeyAssignment, SpawnCommand, SpawnTabDomain};
+
+    #[test]
+    fn blocks_session_creation_but_keeps_closing_available() {
+        assert!(KeyAssignment::SpawnWindow.is_disallowed_in_single_session());
+        assert!(KeyAssignment::SpawnTab(SpawnTabDomain::DefaultDomain)
+            .is_disallowed_in_single_session());
+        assert!(KeyAssignment::SplitVertical(SpawnCommand::default())
+            .is_disallowed_in_single_session());
+        assert!(KeyAssignment::ActivateCommandPalette.is_disallowed_in_single_session());
+        assert!(KeyAssignment::ShowLauncher.is_disallowed_in_single_session());
+        assert!(!KeyAssignment::CloseCurrentTab { confirm: true }
+            .is_disallowed_in_single_session());
+        assert!(!KeyAssignment::CloseCurrentPane { confirm: true }
+            .is_disallowed_in_single_session());
+    }
+}
