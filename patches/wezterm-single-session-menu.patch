+extern "C" fn application_should_handle_reopen(
+    _self: &mut Object,
+    _sel: Sel,
+    app: *mut Object,
+    _has_visible_windows: BOOL,
+) -> BOOL {
+    if !single_session_mode() {
+        return YES;
+    }
+
+    unsafe {
+        let windows: id = msg_send![app, orderedWindows];
+        let window: id = msg_send![windows, firstObject];
+        if window != nil {
+            let miniaturized: BOOL = msg_send![window, isMiniaturized];
+            if miniaturized == YES {
+                let () = msg_send![window, deminiaturize: nil];
+            }
+            let () = msg_send![NSApp(), activateIgnoringOtherApps: YES];
+            let () = msg_send![window, makeKeyAndOrderFront: nil];
+        }
+    }
+    NO
+}
